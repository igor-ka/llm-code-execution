{
  "template": {
    "repo": "igor-ka/acb",
    "commit": "c9a356b4faf56ddacafb93420b8c2e356a1dbbc4"
  },
  "process": {
    "doc": "docs/sdlc-local.md",
    "watched": [
      "^\\.claude/skills/",
      "^\\.github/workflows/",
      "^scripts/",
      "^\\.acb\\.json$",
      "^\\.mutation-scope\\.json$",
      "^\\.github/ruleset\\.json$",
      "^backend/verify\\.sh$",
      "^frontend/verify\\.sh$",
      "^infra/verify\\.sh$",
      "^infra/tests/"
    ],
    "prShapeHatch": "[multi-child]",
    "sdlcSyncHatch": "[skip-sdlc-sync]",
    "dependabotEcosystems": [
      "npm_and_yarn"
    ]
  },
  "components": [
    {
      "id": "backend",
      "checkName": "Backend checks",
      "runner": "ubuntu-latest",
      "targets": [
        "install",
        "audit",
        "lint",
        "format",
        "test",
        "build",
        "migrate",
        "test:integration",
        "package",
        "mutation",
        "mutation:selftest"
      ]
    },
    {
      "id": "frontend",
      "checkName": "Frontend checks",
      "runner": "ubuntu-latest",
      "targets": [
        "install",
        "audit",
        "lint",
        "format",
        "test",
        "build",
        "package"
      ]
    },
    {
      "id": "infra",
      "checkName": "Terraform checks",
      "runner": "ubuntu-latest",
      "targets": [
        "selftest",
        "format",
        "install",
        "lint",
        "gates"
      ]
    }
  ]
}
