# Terraform working directory and provider binaries.
.terraform/

# State. Never committed — it is in GCS, and it contains resource metadata for the whole project.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real variable values (project + billing account IDs). The .example is the committed shape and
# survives because it does not end in .tfvars.
#
# EVERY *.tfvars, not only the auto-loaded names: prod.tfvars is passed with -var-file rather than
# loaded automatically, but it carries the same identifiers. gate_no_state_in_git in verify.sh
# matches this same set — the two lists are meant to agree.
*.tfvars
*.tfvars.json

crash.log
crash.*.log

# NOT ignored, deliberately: .terraform.lock.hcl. It is the provider checksum lock and it MUST be
# committed, or CI resolves a different provider build than the one reviewed here.
