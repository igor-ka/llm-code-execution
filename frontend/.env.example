# Auth0 SPA configuration. These are public client values (shipped in the JS bundle),
# not secrets — there is no client secret for a SPA (it uses PKCE).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Optional: backend base URL (defaults to http://localhost:8000).
# VITE_API_BASE=http://localhost:8000

# Optional: Vite dev-server port (defaults to 5173). Set per worktree by
# scripts/worktree-new.sh — see "Parallel worktrees" in README.md. Any value used here must
# also be registered in the Auth0 SPA's allowed callback / logout / web origins.
# VITE_DEV_PORT=5173
